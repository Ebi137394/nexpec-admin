# ════════════════════════════════════════════════════════════════════════════
#  .gitignore — NEXPEC monorepo
#  Mobile (Expo / React Native) + Web (Next.js) + Supabase + Xcode native app.
# ════════════════════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────────────────
node_modules/

# ─── Build output — Expo / React Native ───────────────────────────────────
.expo/
dist/
web-build/

# ─── Build output — Next.js (apps/web) ────────────────────────────────────
#  HISTORY NOTE: apps/web/.next/ was accidentally tracked between commits
#  42391a4 (fix: remove legacy triggers …) and b37b259 (feat: chemical &
#  process domain). The cleanup commit untracks it via `git rm --cached`.
#  Past pack history still carries those blobs — see "Optional history
#  rewrite" notes in the repo wiki / commit message of the cleanup.
.next/
out/
.turbo/

# ─── TypeScript incremental build cache ───────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─── Test / coverage ──────────────────────────────────────────────────────
coverage/

# ─── Supabase & Environment Variables ─────────────────────────────────────
.env
.env.local
.env.*.local
*.log
supabase/.temp/

# ─── MacOS ────────────────────────────────────────────────────────────────
.DS_Store

# ─── Android / iOS managed-workflow build output ──────────────────────────
#  These are Expo-generated native projects — NOT the hand-written
#  NEXPEC.xcodeproj at repo root, which IS source and IS tracked.
android/
ios/

# ─── Xcode per-user state (keep .xcodeproj itself tracked) ────────────────
#  Per-user schemes and breakpoints inside any .xcodeproj.
**/xcuserdata/
*.xcuserstate

# ─── Vercel ───────────────────────────────────────────────────────────────
.vercel

# ─── Signing keys & secrets — PRIVATE KEYS MUST NEVER BE COMMITTED ─────────
#  The model-signing private key is the root of the Provable-AI moat: anyone
#  who has it can forge a valid signature over any model attestation and defeat
#  on-device verification. Ignore EVERY private-key form; explicitly re-allow
#  *.pub.pem (public keys ARE the trust anchor and are safe — indeed meant — to
#  commit). nexpec_signing_v1.pem was committed by accident in 314e4e7; it is
#  BURNED and must be purged from history — see docs/KEY_CUSTODY.md.
*.pem
*.key
*.p8
*.p12
*.pkcs8
*.pkcs12
*.asc
secrets/
!*.pub.pem
!*.pub.key

# Raw live-DDL dumps from scripts/ops/dump-ghost-ddl.sh (reconciliation artifacts, not source)
supabase/ghost-ddl/

# Local EAS env push helper (carries environment-specific EXPO_PUBLIC keys; do not commit)
scripts/eas-prod-env.sh

# Supabase CLI local branch state (machine-local, never commit)
supabase/.branches/

# Python bytecode cache (e.g. scripts/ml tooling)
__pycache__/
*.pyc
node_modules/.cache/nexpec-ml-tests/

# graphify — generated knowledge-graph output (41MB: graph.json, graph.html,
# GRAPH_REPORT.md, cache/, manifest.json, dated backups). Fully regenerable with
# `graphify update .` (AST-only, no API cost), so it is build output, not source.
# The durable config (.graphifyignore, CLAUDE.md) is NOT ignored — it is source.
graphify-out/

# Deno lockfile generated by local `deno check` of the Edge Functions.
# Not committed: Supabase Edge Runtime resolves these imports itself at deploy
# time, and supabase/functions/deno.json deliberately declares no import map, so
# a locally-pinned lockfile would assert an integrity contract the deploy path
# never consults.
supabase/functions/deno.lock
