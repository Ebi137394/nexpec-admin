# apps/web/.env.local — copy to .env.local and fill in.
# Web mirror of the mobile env vars. Real secrets go in Vercel project
# settings (Production / Preview / Development scopes) — never commit values.

# Canonical site origin — feeds OAuth redirectTo, robots.ts, sitemap.ts, and
# SEO metadata. MUST be set in Vercel production (else falls back to the raw
# VERCEL_URL deployment domain).
NEXT_PUBLIC_SITE_URL=https://nexpecapp.com

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# ── Public web AI-model config (inlined into the client bundle) ──────────────
# Model IDENTITY (slug, version, SHA-256, labels, input size, task) is pinned in
# @nexpec/shared-core NEXPEC_MODELS — the SINGLE source of truth shared with the
# mobile app. On web you only set each model's browser-fetchable .tflite URL; the
# browser verifies the fetched bytes against the registry's pinned SHA-256 before
# loading, and the server independently rejects any recorded detection whose sha
# ≠ the published model_artifacts row. Leave a URL UNSET to keep that model in
# manual mode. Each enabled model needs a literal env var (Next.js only inlines
# literal NEXT_PUBLIC_* refs — see webModelUrl() in lib/data/aiCoinspector.ts).
#
# corrosion-detector v2 (11 classes, 1024², sha 21c98fd8…):
NEXT_PUBLIC_VISION_MODEL_URL=https://<your-host>/models/corrosion_yolo26s_seg_1024_fp32.tflite
# wda-fissure-detector v1 (2 classes, 1024², sha d0f086e0…):
NEXT_PUBLIC_WDA_MODEL_URL=https://<your-host>/models/wda_fissures_yolo26s_seg_1024_fp32.tflite
#
# Legacy/optional (no longer read by the registry-driven loader — identity now
# comes from shared-core; kept here only for reference):
#   NEXT_PUBLIC_VISION_MODEL_SLUG / _VERSION / _SHA256 / _LABELS

# Coordination Bridge portal base URL (public):
NEXT_PUBLIC_BRIDGE_PORTAL_BASE_URL=https://nexpecapp.com/bridge

# Optional cosmetic env label override (leave UNSET in prod — VERCEL_ENV drives
# the badge). If set to "development" it will mislabel the admin header.
# NEXT_PUBLIC_ENV=

# Server-only (Vercel scoped, never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_<your-webhook-signing-secret>
# Comma-separated owner emails — middleware super_admin failsafe:
OWNER_EMAILS=owner@nexpecapp.com
# Contact-form destination + Resend email (server):
CONTACT_INBOX_EMAIL=support@nexpecapp.com
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=NEXPEC <no-reply@nexpecapp.com>
