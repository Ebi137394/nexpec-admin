  ],

  "redactionCases": [
    {
      "name": "buyer-bound-payload-must-not-carry-supplier-economics",
      "orgKind": "enterprise",
      "mustNotRender": ["inspector_payout_cents", "platform_spread_cents", "supplier_rate_cents"],
      "payload": {
        "LIFNR": "0000100234",
        "NAME1": "Hanseatic Stahlwerke GmbH",
        "inspector_payout_cents": 42000,
        "platform_spread_cents": 18000,
        "supplier_rate_cents": 42000,
        "NETWR": "48250.00",
        "WAERS": "EUR"
      }
    },
    {
      "name": "supplier-bound-payload-must-not-carry-client-price",
      "orgKind": "agency",
      "mustNotRender": ["client_price_cents", "buyer_budget_cents", "platform_spread_cents"],
      "payload": {
        "SupplierNumber": "3001884",
        "SupplierName": "Gulf Precision Fabricators LLC",
        "client_price_cents": 60000,
        "buyer_budget_cents": 75000,
        "platform_spread_cents": 18000,
        "Amount": "1250000.00"
      }
    }
  ],

  "idempotencyScenarios": [
    {
      "name": "replay-of-completed-message-changes-nothing",
      "adapter": "sap",
      "steps": ["claim:sap-supplier-create", "complete", "claim:sap-supplier-replay-divergent-body"],
      "expect": {
        "rows": 1,
        "secondClaim": { "claimed": false, "reason": "already_completed" },
        "storedPayloadUnchanged": true,
        "payload_conflict_count": 1
      }
    },
    {
      "name": "exhausting-max-attempts-dead-letters-with-evidence",
      "adapter": "oracle",
      "maxAttempts": 2,
      "steps": ["claim:oracle-supplier-create", "fail:transient", "reclaim", "fail:transient"],
      "expect": {
        "status": "dead_letter",
        "payloadPreserved": true,
        "lastErrorPreserved": true,
        "visibleInDeadLetterQueue": true
      }
    },
    {
      "name": "validation-defect-is-terminal-immediately",
      "adapter": "oracle",
      "steps": ["claim:oracle-inspection-request-bad-timestamp", "process"],
      "expect": {
        "status": "rejected",
        "attemptsBurned": 1,
        "validationErrorsStored": true,
        "visibleInDeadLetterQueue": true
      }
    },
    {
      "name": "replay-of-completed-message-is-refused",
      "adapter": "sap",
      "steps": ["claim:sap-supplier-create", "complete", "operator-replay"],
      "expect": { "raises": "ALREADY_COMPLETED" }
    }
  ]
}
