            { "external_field": "Priority", "canonical_field": "priority", "transform": "lower" },
            { "external_field": "RequesterName", "canonical_field": "requester_name", "transform": "trim" },
            { "external_field": "RequesterEmail", "canonical_field": "requester_email", "transform": "lower" }
          ]
        }
      ],
