{
  "name": "nexpec",
  "version": "1.0.0",
  "private": true,
  "main": "./index",
  "workspaces": [
    "apps/*",
    "!apps/web",
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:web": "cd apps/web && npm run dev",
    "qa:local": "bash scripts/dev/local-qa.sh",
    "build:web": "cd apps/web && npm run build",
    "build:shared": "npm run build -w @nexpec/shared-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "qa:outbox": "node scripts/qa/check-outbox-routing.mjs",
    "qa:outbox:baseline": "node scripts/qa/check-outbox-routing.mjs --write-baseline",
    "qa:db-refs": "node scripts/qa/check-db-refs.mjs",
    "qa:db-refs:baseline": "node scripts/qa/check-db-refs.mjs --write-baseline",
    "qa:e2e:money": "node scripts/qa/e2e-money-flow.mjs",
    "qa:rls-admin": "node scripts/qa/check-rls-admin-coverage.mjs",
    "qa:gr2": "node scripts/qa/check-price-blindness.mjs",
    "qa:gr2-inspector": "node scripts/qa/check-inspector-price-blindness.mjs",
    "qa:assignment-privacy": "node scripts/qa/check-assignment-client-invisibility.mjs",
    "qa:jobs-columns": "node scripts/qa/check-jobs-column-existence.mjs",
    "qa:admin-money": "node scripts/qa/check-admin-money-mapping.mjs",
    "qa:sql-schema": "node scripts/qa/check-sql-schema-refs.mjs",
    "qa:admin-routes": "node scripts/qa/check-admin-route-reachability.mjs",
    "qa:reconcile": "node scripts/qa/capability-reconciliation.mjs",
    "qa:model-shas": "node scripts/qa/check-model-shas.mjs"
  },
  "dependencies": {
