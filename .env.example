# ════════════════════════════════════════════════════════════════════════════
#  .env.example — Template for the .env file
#
#  ⚠️  PRODUCTION CREDENTIAL LEAK CLOSED — NX-SECRET-003 (Phase 5 / Hour 4)
#  ─────────────────────────────────────────────────────────────────────────
#  Until tonight this file shipped REAL production credentials in plaintext
#  (Supabase anon JWT, Supabase SERVICE_ROLE_KEY, Resend API key) and was
#  committed to the repo. If this repo has ever been pushed to a public
#  remote (or to a private remote shared with anyone outside the core team),
#  treat every credential below as compromised.
#
#  IMMEDIATE ACTION REQUIRED:
#    1. Rotate the Supabase anon key + service-role key in the Supabase
#       dashboard → Settings → API → Reset keys.
#    2. Rotate the Resend API key at resend.com/api-keys → Revoke + create.
#    3. Audit `git log -- .env.example` for the commit history of this file.
#       If the leak window matters for compliance, fast-forward the audit
#       trail (audit-trail.sql captures DB events; that's your authoritative
#       record of any service-role activity during the leak window).
#    4. Confirm `.env` (the one with the REAL values) is in .gitignore.
#       Already verified — it is.
#
#  THIS FILE FROM NOW ON contains PLACEHOLDERS ONLY. Never paste real
#  secrets here. Real values go in `.env` (gitignored).
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase (server-side; used by Edge Functions and admin scripts) ──
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Resend (transactional email from Edge Functions) ─────────────────
RESEND_API_KEY=<your-resend-api-key>
# MUST be an address on a domain you have VERIFIED in the Resend dashboard, or
# delivery to arbitrary recipients fails. If unset, the /contact action falls
# back to the onboarding@resend.dev SANDBOX sender, which delivers ONLY to your
# own Resend-account email (every other recipient is silently rejected).
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Where public /contact form submissions are emailed (apps/web server action).
# Set this to a real inbox you monitor, or contact emails are only stored in DB.
# For real delivery here, RESEND_FROM_EMAIL above must be a verified-domain sender.
CONTACT_INBOX_EMAIL=<your-real-inbox@yourdomain.com>

# ── App ──────────────────────────────────────────────────────────────
APP_BASE_URL=https://nexpec.app

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_BUCKET_NAME=dispute-evidence

# ── Edge Functions runtime ───────────────────────────────────────────
FUNCTIONS_TIMEOUT=30000

# ── Stripe (server-side secret — Edge Functions only) ────────────────
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_PAYMENTS_WEBHOOK_SECRET=whsec_<your-payments-webhook-secret>
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<your-connect-webhook-secret>

# ════════════════════════════════════════════════════════════════════════════
#  EXPO_PUBLIC_* vars — bundled into the client JS and shipped to devices.
#  These are NOT secrets (Supabase anon key, Stripe publishable key are
#  designed to be public). Even so, putting them in env keeps test/live
#  swaps clean and matches the eas.json profile env injection pattern.
# ════════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# ── EAS / Expo ───────────────────────────────────────────────────────
# Find at https://expo.dev/accounts/<org>/projects/nexpec or run `eas init`.
EAS_PROJECT_ID=<your-eas-project-id>

# ── Edge function secrets (supabase secrets set) ──────────────────────
CRON_SECRET=<your-cron-secret>
RECON_CRON_SECRET=<your-recon-cron-secret>
NOTIFY_SHARED_SECRET=<your-notify-shared-secret>
WEBHOOK_SECRET=<your-webhook-secret>
WORKER_SHARED_SECRET=<your-worker-shared-secret>
TAX_VAULT_KEY=<your-tax-vault-key>
OPENEXCHANGERATES_APP_ID=<your-openexchangerates-app-id>
BROWSERLESS_API_KEY=<your-browserless-api-key>
NEXPEC_SIGNING_KEY_PRIVATE_PEM=<your-signing-key-private-pem>
NEXPEC_SIGNING_KEY_ID=<your-signing-key-id>
NEXPEC_VERIFY_BASE_URL=https://nexpec.app/verify
EMAIL_FROM=noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
SLACK_WEBHOOK_URL=<your-slack-webhook-url>
TEAMS_WEBHOOK_URL=<your-teams-webhook-url>
SENTRY_ORG=<your-sentry-org>
SENTRY_PROJECT_MOBILE=<your-sentry-project-mobile>
