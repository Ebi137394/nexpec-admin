# apps/web/.env.local — copy to .env.local and fill in.
# Web mirror of the mobile env vars. Real secrets go in Vercel project
# settings (Production / Preview / Development scopes) — never commit values.

# Canonical site origin — feeds OAuth redirectTo, robots.ts, sitemap.ts, and
# SEO metadata. MUST be set in Vercel production (else falls back to the raw
# VERCEL_URL deployment domain).
NEXT_PUBLIC_SITE_URL=https://nexpecapp.com

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# Public web AI-model config (inlined into the client bundle):
NEXT_PUBLIC_VISION_MODEL_URL=https://<your-project-ref>.supabase.co/storage/v1/object/public/models/<model>.tflite
NEXT_PUBLIC_VISION_MODEL_SLUG=corrosion-detector
NEXT_PUBLIC_VISION_MODEL_VERSION=1
NEXT_PUBLIC_VISION_MODEL_SHA=<sha256-of-model>
NEXT_PUBLIC_VISION_LABELS=<comma-separated-labels>

# Coordination Bridge portal base URL (public):
NEXT_PUBLIC_BRIDGE_PORTAL_BASE_URL=https://nexpecapp.com/bridge

# Optional cosmetic env label override (leave UNSET in prod — VERCEL_ENV drives
# the badge). If set to "development" it will mislabel the admin header.
# NEXT_PUBLIC_ENV=

# Server-only (Vercel scoped, never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_<your-webhook-signing-secret>
# Comma-separated owner emails — middleware super_admin failsafe:
OWNER_EMAILS=owner@nexpecapp.com
# Contact-form destination + Resend email (server):
CONTACT_INBOX_EMAIL=support@nexpecapp.com
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=NEXPEC <no-reply@nexpecapp.com>
